# /etc/daddyai-b2.env
# Backblaze B2 credentials for DaddyAI backup system
# Set real values then: chmod 600 /etc/daddyai-b2.env

# ── Backblaze B2 ─────────────────────────────────────────────────────────────
B2_APPLICATION_KEY_ID=YOUR_B2_KEY_ID_HERE
B2_APPLICATION_KEY=YOUR_B2_APPLICATION_KEY_HERE
B2_BUCKET_NAME=daddyai-backups
B2_MAX_GB=10

# ── Supabase (for data export) ────────────────────────────────────────────────
SUPABASE_URL=https://lcpxaoahyxdyhnkxafvf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
