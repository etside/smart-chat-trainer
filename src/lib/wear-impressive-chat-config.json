      "assistant_output": {
        "messages": [
          {"type": "text", "text": "Payment করতে পারেন bKash বা Nagad এ: 01601981194\n\nপেমেন্ট করার পর স্ক্রিনশট পাঠাবেন। কোন প্রোডাক্ট অর্ডার করবেন?", "language": "mixed", "sender": "agent"}
