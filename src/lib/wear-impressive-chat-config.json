              "actions": [{"type": "url", "label": "Order Now", "url": "https://wearimpressive.com/product/cargo-pant", "style": "primary_green", "icon": "cart"}]
            }
          }
        ],
        "conversation_state": {"intent": "product_search", "order_stage": "product_selected", "selected_product_id": "cargo-pant-001", "handoff_required": false}
      }
    },
    {
      "name": "product_reply_banglish",
      "customer": "Combo set ache?",
      "tool_call": {"name": "search_training_pairs", "arguments": {"query": "combo set", "limit": 3}},
      "assistant_output": {
        "messages": [
          {"type": "text", "text": "Ha! Amader combo sets ache. Niche details dilam—order korte Order Now button-e click korun.", "language": "banglish", "sender": "agent"},
          {
            "type": "product_card",
            "product_card": {
              "product_id": "combo-set-001",
              "title": "Premium Combo Set",
              "image_url": "https://wearimpressive.com/wp-content/uploads/combo-set.jpg",
              "price": 1990,
              "currency": "BDT",
              "availability": "In stock",
              "features": ["Best Value", "Premium Quality", "Multiple Color Options"],
              "actions": [{"type": "url", "label": "Order Now", "url": "https://wearimpressive.com/product/combo-set", "style": "primary_green", "icon": "cart"}]
            }
          }
        ],
        "conversation_state": {"intent": "product_search", "order_stage": "product_selected", "selected_product_id": "combo-set-001", "handoff_required": false}
      }
    },
    {
      "name": "delivery_query",
      "customer": "Delivery charge koto?",
