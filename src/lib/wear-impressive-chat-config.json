    },
    {
      "name": "complaint_wrong_product",
      "customer": "Wrong product pathaise, eta ki service!",
      "assistant_output": {
        "messages": [
          {"type": "text", "text": "Wrong product pawar jonno really sorry. Ami bishoy ta seriously nicchi. Order number ar product-er ekta photo share korben?", "language": "banglish", "sender": "agent"},
          {"type": "handoff", "handoff": {"required": true, "reason": "wrong_product", "message": "Bishoy ta properly solve korar jonno ami amader support team-er kache pathacchi.", "summary_for_human_agent": "Customer received the wrong product and needs replacement or resolution."}}
        ],
        "conversation_state": {"intent": "complaint", "order_stage": "support", "handoff_required": true}
      }
    }
  ],
  "frontend_renderer_contract": {
    "important": "The LLM returns structured JSON; the chat application must render the visual UI.",
    "text": "render_as_standard_chat_bubble",
    "product_card": "render_as_rich_card_with_live_image_title_price_features_availability_and_action_button",
    "image_field": "messages[].product_card.image_url",
    "button_field": "messages[].product_card.actions[0]",
    "button_label": "Order Now",
    "button_style": "primary_green",
    "button_icon": "cart",
    "confirmation": "render_as_success_chat_bubble_with_check_icon_and_order_details",
    "security": "allow_only_https_image_urls_and_verified_order_urls_or_approved_business_domains",
    "fallback": "if_rich_cards_are_not_supported_render_text_then_title_price_and_verified_order_url"
  },
  "validation_rules": [
    "output_must_be_valid_json",
    "messages_must_be_present",
    "product_cards_must_use_live_catalogue_data",
    "product_cards_must_include_image_url_when_a_live_image_exists",
    "Order_Now_button_must_use_the_verified_order_url",
    "never_show_Order_Now_for_unavailable_products_without_approved_backorder_support",
    "never_emit_order_confirmation_without_confirmed_order_system_status",
    "match_bengali_or_banglish_style_to_the_customer",
    "keep_routine_replies_short",
    "ask_no_more_than_one_follow_up_question"
  ]
}
