{
  "gateway": {
    "mode": "local",
    "trustedProxies": [
      "127.0.0.1",
      "::1"
    ],
    "controlUi": {
      "allowedOrigins": [
        "https://openclaw.daddyai.online",
        "http://openclaw.daddyai.online"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "auth": {
      "mode": "token",
      "password": ""
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true
    },
    "lastTouchedVersion": "2026.8.2"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "bai": {
        "baseUrl": "https://api.b.ai/v1",
        "apiKey": "",
        "api": "openai-completions",
        "models": [
          {
            "id": "hy3",
            "name": "Hunyuan 3 (free reasoning)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "glm-5.3-flash",
            "name": "GLM 5.3 Flash (free)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "qwen3.8-flash",
            "name": "Qwen 3.8 Flash (free)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "",
        "api": "openai-completions",
        "models": [
          {
            "id": "minimax/minimax-m3:free",
            "name": "MiniMax M3 (free)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "bai/hy3",
        "fallbacks": [
          "bai/glm-5.3-flash",
          "bai/qwen3.8-flash",
          "openrouter/minimax/minimax-m3:free"
        ]
      },
      "repoRoot": "/var/www/daddyai",
      "utilityModel": "bai/qwen3.8-flash"
    }
  },
  "browser": {
    "noSandbox": true
  },
  "plugins": {
    "entries": {
      "browser": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "device-pair": {
        "enabled": false
      },
      "canvas": {
        "enabled": false
      },
      "cua-computer": {
        "enabled": false
      },
      "geolocation": {
        "enabled": false
      },
      "ollama": {
        "enabled": false
      },
      "xai": {
        "enabled": false
      },
      "fish-audio-speech": {
        "enabled": true
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "",
      "dmPolicy": "pairing",
      "direct": {
        "*": {
          "systemPrompt": "You are a vibe-coder assistant chatting with the user on Telegram. Keep ALL replies in a short, casual, friendly texting style \u2014 like a friend sending a quick message. 1-3 sentences max unless the user asks for more. No formal reports, no bullet points, no numbered lists. Use natural conversational language. Show personality. When the user asks about technical work (coding, debugging, server tasks), give a quick texting-style summary of what you did or found, then mention that the details are available if needed. Never dump raw output into the chat. Complex technical work should be done in the background (GitHub Actions, automations, cron) \u2014 report back briefly in vibe-texting style here."
        }
      }
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:7464270482"
    ]
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "skills": {
    "entries": {
      "1password": {
        "enabled": false
      }
    }
  },
  "mcp": {
    "servers": {
      "Wear_Impressive_MCP": {
        "url": "https://daddyai.online/mcp",
        "transport": "streamable-http",
        "enabled": false
      }
    }
  },
  "ui": {
    "prefs": {
      "themeMode": "light",
      "theme": "miami",
      "accent": "#ff5c5c"
    }
  }
}