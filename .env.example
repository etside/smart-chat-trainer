# Supabase Connection
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API Sync & Webhooks
# Token for https://api.v2.wearimpressive.com
SYNC_TOKEN=your-sync-bearer-token
# Secret for HMAC verification
SYNC_SECRET=your-sync-secret
# Secret for your incoming webhook
WEBHOOK_SECRET=your-webhook-secret

# Meta Business Integration
VITE_META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# B2B Services
B2B_BACKBLAZE_KEY=your-backblaze-key
BOSON_WORKSPACE_ID=your-boson-workspace-id
FISH_AUDIO_API_KEY=your-fish-audio-api-key

# VPS Hosting Configuration (JSON)
# VPS_HOSTING_CONFIG={"host": "1.2.3.4", "user": "admin"}
